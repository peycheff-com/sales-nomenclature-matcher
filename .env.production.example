# ======================================================================
# PRODUCTION ENVIRONMENT -- Change ALL placeholder values before deploy!
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: LOG_LEVEL must NOT be DEBUG in production (bypasses security checks)
# ======================================================================

# Database
# Generate password: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://matcher:CHANGE_ME@db:5432/matcher

# Redis (set a password for production!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379

# Optional hosted provider API keys. Leave empty for the free local/default mode.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# Provider defaults: free local mode.
# Local embeddings/rerank require the image built with USE_LOCAL=true or
# `uv sync --extra local` in a source checkout. Local chat expects an
# OpenAI-compatible Ollama endpoint at http://localhost:11434/v1.
EMBEDDING_PROVIDER=local
LLM_PROVIDER=local
RERANK_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
LLM_MODEL=qwen2.5:7b-instruct

# Security -- MANDATORY: generate a unique 64-char hex secret
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
CORS_ORIGINS=["https://your-domain.com"]

# Cookie transport for JWT (httpOnly + Secure in production)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=your-domain.com  # Uncomment if needed for subdomain sharing

# Logging
LOG_LEVEL=INFO

# Telegram Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backup (DigitalOcean Spaces)
PGHOST=db
PGUSER=matcher
PGPASSWORD=CHANGE_ME
PGDATABASE=matcher
S3_ENDPOINT=ams3.digitaloceanspaces.com
S3_BUCKET=matcher-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
